{
  "name": "dsh-market-xivie",
  "version": "0.1.0",
  "description": "DSH 插件市场：在左侧导航和插件页各加一个「我的市场」入口，浏览并安装索引里的插件。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "napcat.js",
    "client.js",
    "cordis.patch.yml",
    "heal-allowlist.json",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin-market"
  ],
  "author": "xivie-a",
  "license": "UNLICENSED",
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
